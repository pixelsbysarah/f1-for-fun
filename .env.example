# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored and must never be committed.
#
# PLACEHOLDER NAMES ONLY — do not put real keys, tokens, or connection
# strings in this file. All real secrets live in Vercel env vars (production)
# or your local `.env.local` (development). See CLAUDE.md rule #1.

# --- Supabase (wired up in Ticket 2) ---
# For LOCAL development these come from `supabase start` output (see README).
# For PRODUCTION these come from the hosted Supabase project, set in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenTelemetry (observability — optional, dev/demo only) ---
# Unset by default: instrumentation.ts becomes a no-op, nothing is exported.
# See OBSERVABILITY.md for where these values come from (Grafana Cloud, or a
# local endpoint if you're running the observability/ Docker stack) and the
# exact header format — a malformed OTEL_EXPORTER_OTLP_HEADERS silently sends
# no Authorization header at all, not an error.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
