# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored and must never be committed.
#
# PLACEHOLDER NAMES ONLY — do not put real keys, tokens, or connection
# strings in this file. All real secrets live in Vercel env vars (production)
# or your local `.env.local` (development). See CLAUDE.md rule #1.

# --- Supabase (wired up in Ticket 2) ---
# For LOCAL development these come from `supabase start` output (see README).
# For PRODUCTION these come from the hosted Supabase project, set in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
