{
  "title": "f1-for-fun — Observability",
  "uid": "f1-for-fun-observability",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["f1-for-fun"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "description": "Requests/sec by route, derived from Next's auto-instrumented request spans (see otel-collector-config.yaml's span_metrics connector) — no middleware timing code involved.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_calls_total{http_route!=\"\"}[5m])) by (http_route)",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 request latency",
      "description": "95th-percentile request duration by route, from the same span-derived metric as request rate.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{http_route!=\"\"}[5m])) by (le, http_route))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Supabase query duration (p95)",
      "description": "95th-percentile Supabase query duration by table + operation, from the db.client.operation.duration histogram recorded in instrumentSupabase() (lib/metrics/supabase.ts).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(db_client_operation_duration_seconds_bucket[5m])) by (le, db_collection_name, db_operation_name))",
          "legendFormat": "{{db_collection_name}} · {{db_operation_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Supabase query outcomes",
      "description": "Query volume by table + outcome — a quick way to spot a table suddenly erroring (e.g. an RLS denial) rather than just slowing down.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(db_client_operation_duration_seconds_count[5m])) by (db_collection_name, outcome)",
          "legendFormat": "{{db_collection_name}} · {{outcome}}",
          "refId": "A"
        }
      ]
    }
  ]
}
